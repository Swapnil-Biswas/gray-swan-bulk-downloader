{
  "manifest_version": 3,
  "name": "Gray Swan Arena Bulk Export",
  "version": "1.1.0",
  "description": "Export your own Arena chats, submissions and batches (JSON or CSV) into one zip file, with a range you choose.",
  "homepage_url": "https://github.com/Swapnil-Biswas/gray-swan-bulk-downloader",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://app.grayswan.ai/arena/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
